// App 的统一配置：修改后在 Xcode 按 Cmd+R 重新运行。
// 等号后直接填值，不需要引号。Debug 和 Release 共用此文件。

// 对用户显示的版本号，例如 1.0、1.1、2.0.1。
MARKETING_VERSION = 1.0

// 内部构建号：发布新的构建时递增，例如 1、2、3。
CURRENT_PROJECT_VERSION = 1

// App 显示名称、欢迎页介绍、署名。
APP_DISPLAY_NAME = ChooseMyLLM
APP_TAGLINE = Find the right model for you.
APP_CREDIT = Created by Qixuan Xu

// 欢迎页停留时间，单位为秒；填 0 可立即进入主窗口。
SPLASH_DURATION_SECONDS = 1.5

// 以下为配置接线，通常不需要修改。
INFOPLIST_FILE = ConfigInfo.plist
GENERATE_INFOPLIST_FILE = YES
